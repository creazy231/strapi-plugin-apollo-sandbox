{
  "version": "0.0.0",
  "keywords": [],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "test:ts:back": "run -T tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@apollo/sandbox": "^2.7.0",
    "@strapi/design-system": "^2.0.0-rc.11",
    "@strapi/icons": "^2.0.0-rc.11",
    "localtunnel": "^2.0.2",
    "react-intl": "^6.8.0"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^5.2.7",
    "@strapi/strapi": "^5.0.6",
    "@strapi/typescript-utils": "^5.0.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "styled-components": "^6.1.13",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@strapi/sdk-plugin": "^5.2.7",
    "@strapi/strapi": "^5.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "styled-components": "^6.1.13"
  },
  "strapi": {
    "kind": "plugin",
    "name": "apollo-sandbox",
    "displayName": "Apollo Sandbox",
    "description": "Integrate Apollo Sandbox for a powerful GraphQL Explorer in your Strapi Admin Interface"
  },
  "name": "apollo-sandbox",
  "description": "Integrate Apollo Sandbox for a powerful GraphQL Explorer in your Strapi Admin Interface",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/creazy231/strapi-plugin-apollo-sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/creazy231/strapi-plugin-apollo-sandbox/issues"
  },
  "homepage": "https://github.com/creazy231/strapi-plugin-apollo-sandbox#readme",
  "author": "Tobias Thiele <thiele231@web.de>"
}
